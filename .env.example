# ==============================================================================
# Kestrel Monorepo — Unified Environment Configuration
# ==============================================================================
# Copy this file to .env at the root of the repository:
#   cp .env.example .env
# ==============================================================================

# --- Backend Configuration ---
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Groq Cloud LLM API Key (Optional — Free at https://console.groq.com/keys)
# If blank, the Copilot uses the grounded database fallback stream
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# --- Frontend Configuration ---
VITE_API_SOURCE=live
VITE_API_BASE_URL=/api
VITE_OFFLINE_MODE=false

# --- Local Supabase Stack ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
VITE_SUPABASE_URL=http://127.0.0.1:54321
