{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@kestrel/shared": ["../packages/shared/src/index.ts"],
      "@kestrel/shared/*": ["../packages/shared/src/*"],
      "@shared/*": ["../packages/shared/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["src/scripts/**/*", "node_modules", "dist"]
}
